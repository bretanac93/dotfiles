# Essential dependencies for dotfiles functionality
# Install these first: brew bundle install --file=Brewfile

brew "fzf"
brew "fd"
brew "tmux"
brew "direnv"  # oh-my-zsh direnv plugin
brew "neovim"
brew "git"
brew "gh"  # GitHub CLI
brew "shellcheck"
brew "ripgrep"
brew "gnupg"  # Required for GPG commit signing
brew "deno"  # Required for markdown-preview.nvim
brew "tree-sitter-cli"  # Required by nvim-treesitter (main) to build parsers
brew "ktlint"  # Kotlin formatter used by conform.nvim

# 1Password for secure secret storage and GPG key management
cask "1password"
cask "1password-cli"
